<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:BloodborneLauncher.Controls" xmlns:core="clr-namespace:BloodborneLauncher.Core" xmlns:views="clr-namespace:BloodborneLauncher.Views">
 <!-- Small native control foundation; Bloodborne.xaml supplies the visible menu templates. -->
 <Style TargetType="ToolTip">
  <Setter Property="Foreground" Value="#FFC8B48A"/>
  <Setter Property="FontFamily" Value="{x:Static core:LauncherAppearance.DetailFont}"/>
  <Setter Property="FontSize" Value="17"/>
  <Setter Property="Padding" Value="28,22"/>
  <Setter Property="MaxWidth" Value="520"/>
  <Setter Property="HasDropShadow" Value="False"/>
  <Setter Property="OverridesDefaultStyle" Value="True"/>
  <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
   <views:MenuSurface Padding="{TemplateBinding Padding}" IsHitTestVisible="False">
    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
   </views:MenuSurface>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ContextMenu"><Setter Property="Background" Value="#FF141719"/><Setter Property="Foreground" Value="#FFE3DDCB"/><Setter Property="FontSize" Value="15.75"/></Style>
 <Style TargetType="MenuItem"><Setter Property="Padding" Value="12,7"/><Setter Property="FontSize" Value="15.75"/></Style>
 <Style TargetType="TextBox"><Setter Property="Background" Value="#FF101315"/><Setter Property="Foreground" Value="#FFE3DDCB"/><Setter Property="CaretBrush" Value="#FFE3DDCB"/><Setter Property="BorderBrush" Value="#FF737875"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="10,7"/><Setter Property="FontFamily" Value="{x:Static core:LauncherAppearance.DetailFont}"/><Setter Property="FontSize" Value="14.875"/></Style>
 <!-- TextBoxBase forwards Padding to PART_ContentHost. Applying it to the border as well
      shrinks the text viewport twice and pushes a typed line outside a compact search field. -->
 <Style TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="ui:TextBox">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}" ClipToBounds="True">
     <Grid>
      <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
      <TextBlock x:Name="Placeholder" Text="{TemplateBinding PlaceholderText}"
                 Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                 Foreground="#FFAD9A72" IsHitTestVisible="False" Visibility="Collapsed"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="AcceptsReturn" Value="True"><Setter Property="VerticalContentAlignment" Value="Top"/></Trigger>
     <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>
 <Style TargetType="PasswordBox"><Setter Property="Background" Value="#FF101315"/><Setter Property="Foreground" Value="#FFE3DDCB"/><Setter Property="BorderBrush" Value="#FF737875"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="10,7"/><Setter Property="FontSize" Value="14.875"/></Style>
 <Style TargetType="ui:InfoBar"><Setter Property="FontFamily" Value="{x:Static core:LauncherAppearance.DetailFont}"/><Setter Property="FontSize" Value="14.875"/><Setter Property="Foreground" Value="#FFD4B579"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ui:InfoBar"><Border Background="#CC17191B" Padding="14"><StackPanel><TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{TemplateBinding Message}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ListView"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#FFE3DDCB"/><Setter Property="BorderThickness" Value="0"/></Style>
 <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#FFE3DDCB"/><Setter Property="BorderThickness" Value="0"/></Style>
</ResourceDictionary>
