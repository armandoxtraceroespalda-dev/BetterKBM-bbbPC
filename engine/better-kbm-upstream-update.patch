+    }
+    if (it != address_bound.end()) {
+        std::printf("    nearest above: %s [%#llx, +%#llx) %s\n", ObjectTypeName(it->second.type),
+                    static_cast<unsigned long long>(it->second.base),
+                    static_cast<unsigned long long>(it->second.size), it->second.name);
