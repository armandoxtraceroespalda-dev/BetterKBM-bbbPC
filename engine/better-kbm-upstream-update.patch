+const std::string& NetUtilInternal::GetIp() const {
+    return ip;
+}
+
+u32 NetUtilInternal::GetExternalIp() const {
+    return external_ip;
+}
+
+void NetUtilInternal::SetExternalIp(u32 addr) {
+    external_ip = addr;
+}
