+def configure_live_resolution(config, out):
+    """Resolve once for every output, including native 1080p and TAA, and pass it to the renderer."""
+    # A restarted probe inherits our resolved flag. Do not mistake that generated value
+    # for an explicit user override and pin the old selection across Apply and restart.
+    source = os.environ.get('BB_LIVE_RES_SOURCE')
+    override = None if source == 'settings' else 'auto' if source == 'auto-override' else os.environ.get('BB_LIVE_RES')
+    requested = override or settings_value(config, 'live_resolution') or '0'
+    if not override:
+        os.environ['BB_LIVE_RES_SOURCE'] = 'settings'
+    elif override == 'auto':
+        os.environ['BB_LIVE_RES_SOURCE'] = 'auto-override'
+    else:
+        os.environ.pop('BB_LIVE_RES_SOURCE', None)
+    resolved = requested
+    if requested == 'auto':
+        resolved = run([out / 'bb-gpu-capabilities.exe', '--live-resolution'], capture=True, check=False) or '0'
+    resolved = '1' if resolved == '1' else '0'
+    os.environ['BB_LIVE_RES'] = resolved
+    print(f'Live output resolution changes: {"on" if resolved == "1" else "off (restart required)"}', flush=True)
+    return resolved
 
 
