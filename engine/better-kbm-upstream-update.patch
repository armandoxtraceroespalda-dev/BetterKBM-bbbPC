+    SeekPenaltyAnswer answer={0,0,0};
+    DWORD got=0;
+    BOOL ok=DeviceIoControl(h,IOCTL_STORAGE_QUERY_PROPERTY,&query,sizeof(query),&answer,sizeof(answer),&got,NULL);
